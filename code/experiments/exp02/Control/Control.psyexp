        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="psychoJS.window.mouseVisible = true;&amp;#10;form_resp_f_mouse.setPos([0, (- 0.25)]);&amp;#10;form_resp_f_selection_polygon.setAutoDraw(false);&amp;#10;form_resp_f_selection_polygon.opacity = 0;&amp;#10;selection_made = false;&amp;#10;form_cate_trial += 1;&amp;#10;form_current_gender = &quot;female&quot;;&amp;#10;start_time = core.getTime();&amp;#10;form_cate_resp = null;&amp;#10;form_cate_rt = null;&amp;#10;form_previous_gender = form_current_gender;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="##############&amp;#10;# 以下是组件基本设置的代码：&amp;#10;&amp;#10;# 显示鼠标&amp;#10;win.mouseVisible = True&amp;#10;# 初始化鼠标位置在slider中间&amp;#10;form_resp_f_mouse.setPos([0, -0.25])&amp;#10;&amp;#10;# 确保选择框在开始时完全隐藏&amp;#10;form_resp_f_selection_polygon.setAutoDraw(False)&amp;#10;# 额外保险措施&amp;#10;form_resp_f_selection_polygon.opacity = 0&amp;#10;&amp;#10;# 方框代码中关键变量的初始化&amp;#10;selection_made = False&amp;#10;&amp;#10;############&amp;#10;# 以下是和数据保存相关的代码&amp;#10;# 数据保存时，开心编码为1，悲伤编码为0&amp;#10;# 试次记录和性别&amp;#10;form_cate_trial += 1  # 试次计数+1&amp;#10;form_current_gender = 'female'&amp;#10;&amp;#10;# 用于记录被试反应和反应时&amp;#10;start_time = core.getTime()&amp;#10;form_cate_resp = None&amp;#10;form_cate_rt = None&amp;#10;&amp;#10;# 更新previous_gender变量，&amp;#10;# 为下一个试次的mini-block检测做准备&amp;#10;form_previous_gender = form_current_gender&amp;#10;&amp;#10;&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="##########&amp;#10;# 以下代码是为了在被试所选择的情绪标签周围显示方框&amp;#10;# 并记录选择和反应时间&amp;#10;&amp;#10;# 检查鼠标是否悬浮在左边文本上方（开心=1）&amp;#10;if form_resp_f_left_text.contains(form_resp_f_mouse):&amp;#10;    # 鼠标悬浮时显示预览方框（以下都是方框的参数设置）&amp;#10;    form_resp_f_selection_polygon.setPos((form_resp_f_left_text.pos[0], form_resp_f_left_text.pos[1] + 0))&amp;#10;    form_resp_f_selection_polygon.setSize((0.1, 0.05))&amp;#10;    form_resp_f_selection_polygon.fillColor = None  # 内部透明&amp;#10;    form_resp_f_selection_polygon.lineColor = 'black'  # 边框黑色&amp;#10;    form_resp_f_selection_polygon.opacity = 1.0  # 不透明&amp;#10;    form_resp_f_selection_polygon.setAutoDraw(True)&amp;#10;    # 检测鼠标点击&amp;#10;    if form_resp_f_mouse.isPressedIn(form_resp_f_left_text):&amp;#10;        # 记录选择内容（左边开心=1）&amp;#10;        form_cate_resp = 1&amp;#10;        # 记录反应时间&amp;#10;        form_cate_rt = round(core.getTime() - start_time, 2)&amp;#10;        # 确认选择后方框样式&amp;#10;        form_resp_f_selection_polygon.opacity = 1.0&amp;#10;        # 鼠标点击后，routine结束&amp;#10;        continueRoutine = False&amp;#10;&amp;#10;# 检查鼠标是否悬浮在右边文本上方（悲伤=0）&amp;#10;elif form_resp_f_right_text.contains(form_resp_f_mouse):&amp;#10;    # 鼠标悬浮时显示预览方框&amp;#10;    form_resp_f_selection_polygon.setPos((form_resp_f_right_text.pos[0], form_resp_f_right_text.pos[1] + 0))&amp;#10;    form_resp_f_selection_polygon.setSize((0.1, 0.05))&amp;#10;    form_resp_f_selection_polygon.fillColor = None&amp;#10;    form_resp_f_selection_polygon.lineColor = 'black'&amp;#10;    form_resp_f_selection_polygon.opacity = 1.0&amp;#10;    form_resp_f_selection_polygon.setAutoDraw(True)&amp;#10;    # 检测鼠标点击&amp;#10;    if form_resp_f_mouse.isPressedIn(form_resp_f_right_text):&amp;#10;        # 记录选择内容（右边悲伤=0）&amp;#10;        form_cate_resp = 0&amp;#10;        # 记录反应时间&amp;#10;        form_cate_rt = round(core.getTime() - start_time, 2)&amp;#10;        # 确认选择后方框样式&amp;#10;        form_resp_f_selection_polygon.opacity = 1.0&amp;#10;        # 鼠标点击后，routine结束&amp;#10;        continueRoutine = False&amp;#10;&amp;#10;# 鼠标不在任何文本上方时，确保方框隐藏&amp;#10;else:&amp;#10;    form_resp_f_selection_polygon.setAutoDraw(False)&amp;#10;&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (form_resp_f_left_text.contains(form_resp_f_mouse)) {&amp;#10;    form_resp_f_selection_polygon.setPos([form_resp_f_left_text.pos[0], (form_resp_f_left_text.pos[1] + 0)]);&amp;#10;    form_resp_f_selection_polygon.setSize([0.1, 0.05]);&amp;#10;    form_resp_f_selection_polygon.fillColor = null;&amp;#10;    form_resp_f_selection_polygon.lineColor = &quot;black&quot;;&amp;#10;    form_resp_f_selection_polygon.opacity = 1.0;&amp;#10;    form_resp_f_selection_polygon.setAutoDraw(true);&amp;#10;    if (form_resp_f_mouse.isPressedIn(form_resp_f_left_text)) {&amp;#10;        form_cate_resp = 1;&amp;#10;        form_cate_rt = util.round((core.getTime() - start_time), 2);&amp;#10;        form_resp_f_selection_polygon.opacity = 1.0;&amp;#10;        continueRoutine = false;&amp;#10;    }&amp;#10;} else {&amp;#10;    if (form_resp_f_right_text.contains(form_resp_f_mouse)) {&amp;#10;        form_resp_f_selection_polygon.setPos([form_resp_f_right_text.pos[0], (form_resp_f_right_text.pos[1] + 0)]);&amp;#10;        form_resp_f_selection_polygon.setSize([0.1, 0.05]);&amp;#10;        form_resp_f_selection_polygon.fillColor = null;&amp;#10;        form_resp_f_selection_polygon.lineColor = &quot;black&quot;;&amp;#10;        form_resp_f_selection_polygon.opacity = 1.0;&amp;#10;        form_resp_f_selection_polygon.setAutoDraw(true);&amp;#10;        if (form_resp_f_mouse.isPressedIn(form_resp_f_right_text)) {&amp;#10;            form_cate_resp = 0;&amp;#10;            form_cate_rt = util.round((core.getTime() - start_time), 2);&amp;#10;            form_resp_f_selection_polygon.opacity = 1.0;&amp;#10;            continueRoutine = false;&amp;#10;        }&amp;#10;    } else {&amp;#10;        form_resp_f_selection_polygon.setAutoDraw(false);&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="psychoJS.experiment.addData(&quot;form_cate_block&quot;, form_cate_block);&amp;#10;psychoJS.experiment.addData(&quot;form_cate_trial&quot;, form_cate_trial);&amp;#10;psychoJS.experiment.addData(&quot;form_current_gender&quot;, form_current_gender);&amp;#10;psychoJS.experiment.addData(&quot;form_cate_resp&quot;, form_cate_resp);&amp;#10;psychoJS.experiment.addData(&quot;form_cate_rt&quot;, form_cate_rt);&amp;#10;psychoJS.experiment.nextEntry();&amp;#10;psychoJS.window.mouseVisible = false;&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="#########&amp;#10;# 以下代码是为了保存数据&amp;#10;&amp;#10;# block数&amp;#10;thisExp.addData('form_cate_block', form_cate_block)&amp;#10;# trial数&amp;#10;thisExp.addData('form_cate_trial', form_cate_trial)&amp;#10;# 当前模特性别&amp;#10;thisExp.addData('form_current_gender', form_current_gender)&amp;#10;# 被试所选的情绪类别&amp;#10;thisExp.addData('form_cate_resp', form_cate_resp)&amp;#10;# 反应时间&amp;#10;thisExp.addData('form_cate_rt', form_cate_rt)&amp;#10;# 进入下一条数据记录&amp;#10;thisExp.nextEntry()&amp;#10;&amp;#10;# 隐藏鼠标&amp;#10;win.mouseVisible = False&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="form_resp_f_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
