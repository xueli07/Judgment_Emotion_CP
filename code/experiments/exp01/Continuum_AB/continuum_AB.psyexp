        <Param val="form_cont_block += 1;&amp;#10;progress_text = new visual.TextStim({&quot;win&quot;: psychoJS.window, &quot;text&quot;: `已完成${(form_cont_block - 1)}/3部分`, &quot;font&quot;: &quot;Arial&quot;, &quot;pos&quot;: [0, 0.1], &quot;height&quot;: 0.03, &quot;color&quot;: &quot;black&quot;});&amp;#10;text_start_time = core.getTime();&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="##########&amp;#10;# 每次休息，block计数器＋1&amp;#10;form_cont_block += 1&amp;#10;&amp;#10;#########&amp;#10;# 显示实验进度&amp;#10;progress_text = visual.TextStim(&amp;#10;    win=win,&amp;#10;    text=f'已完成{form_cont_block - 1}/3部分',  # 直接在这里计算&amp;#10;    font='Arial',&amp;#10;    pos=[0, 0.1],  # 纵坐标0.1&amp;#10;    height=0.03,&amp;#10;    color='black'&amp;#10;)&amp;#10;&amp;#10;# 记录文本开始显示的时间&amp;#10;text_start_time = core.getTime()  " valType="extendedCode" updates="constant" name="Begin Routine"/>
