      <CodeComponent name="instr4_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="instr4_center_text.alignText = &quot;left&quot;;&amp;#10;instr4_top_text.alignText = &quot;left&quot;;&amp;#10;psychoJS.window.mouseVisible = true;&amp;#10;instr4_mouse.setPos([0, 0.1]);&amp;#10;instr4_slider.marker.size = [0.02, 0.08];&amp;#10;instr4_slider.marker.shape = &quot;square&quot;;&amp;#10;instr4_slider.marker.fillColor = &quot;white&quot;;&amp;#10;slider_width = 0.8;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# 控制文字的左对齐&amp;#10;instr4_center_text.alignText = 'left'  # 设置左对齐&amp;#10;instr4_top_text.alignText = 'left'&amp;#10;&amp;#10;# 显示鼠标可见&amp;#10;win.mouseVisible = True&amp;#10;&amp;#10;# 初始化鼠标位置在slider中间&amp;#10;instr4_mouse.setPos([0, 0.1])&amp;#10;&amp;#10;# 设置slider的marker外观&amp;#10;# marker就是鼠标在直线上的光标&amp;#10;instr4_slider.marker.size = (0.02, 0.08)  # 设置marker大小（宽度，高度）&amp;#10;instr4_slider.marker.shape = 'square'     # 设置为方形&amp;#10;instr4_slider.marker.fillColor = 'white'    # 设置颜色&amp;#10;&amp;#10;# 记录slider宽度，用于后续计算&amp;#10;slider_width = 0.8  " valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="# 获取当前鼠标位置&amp;#10;mouse_pos = instr4_mouse.getPos()&amp;#10;mouse_x, mouse_y = mouse_pos&amp;#10;&amp;#10;# 基于slider的位置和大小，计算slider的边界&amp;#10;slider_center_x = 0      # slider的中心x坐标&amp;#10;slider_center_y = 0.1    # slider的中心y坐标&amp;#10;slider_left = slider_center_x - slider_width/2    # 左边界&amp;#10;slider_right = slider_center_x + slider_width/2   # 右边界&amp;#10;slider_bottom = slider_center_y - 0.025          # 下边界&amp;#10;slider_top = slider_center_y + 0.025             # 上边界&amp;#10;&amp;#10;# 检查鼠标是否在slider区域内（四个边界条件）&amp;#10;mouse_in_slider = (slider_left &lt;= mouse_x &lt;= slider_right and &amp;#10;                   slider_bottom &lt;= mouse_y &lt;= slider_top)&amp;#10;                   &amp;#10;if mouse_in_slider:&amp;#10;    # 当鼠标在slider上时，让marker跟随鼠标移动&amp;#10;    &amp;#10;    # 将鼠标x坐标转换为slider的0-1范围&amp;#10;    # 这个计算将屏幕坐标映射到评分坐标&amp;#10;    slider_value = (mouse_x - slider_left) / slider_width&amp;#10;    &amp;#10;    # 限制数值在有效范围内，防止超出边界&amp;#10;    slider_value = max(0, min(1, slider_value))&amp;#10;    &amp;#10;    # 设置marker位置，这会让光标跟随鼠标移动&amp;#10;    instr4_slider.markerPos = slider_value&amp;#10;    &amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="mouse_pos = instr4_mouse.getPos();&amp;#10;[mouse_x, mouse_y] = mouse_pos;&amp;#10;slider_center_x = 0;&amp;#10;slider_center_y = 0.1;&amp;#10;slider_left = (slider_center_x - (slider_width / 2));&amp;#10;slider_right = (slider_center_x + (slider_width / 2));&amp;#10;slider_bottom = (slider_center_y - 0.025);&amp;#10;slider_top = (slider_center_y + 0.025);&amp;#10;mouse_in_slider = (((slider_left &lt;= mouse_x) &amp;&amp; (mouse_x &lt;= slider_right)) &amp;&amp; ((slider_bottom &lt;= mouse_y) &amp;&amp; (mouse_y &lt;= slider_top)));&amp;#10;if (mouse_in_slider) {&amp;#10;    slider_value = ((mouse_x - slider_left) / slider_width);&amp;#10;    slider_value = Math.max(0, Math.min(1, slider_value));&amp;#10;    instr4_slider.markerPos = slider_value;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="instr4_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
