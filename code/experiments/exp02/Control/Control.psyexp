      <CodeComponent name="prac_xab_ab_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="#########&amp;#10;# 以下代码为了保存数据&amp;#10;prac_xab_block = 1  # block计数器（每次重新开始练习时+1）&amp;#10;prac_xab_trial = 0  # trial计数器（每个试次+1）" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="prac_xab_block = 1;&amp;#10;prac_xab_trial = 0;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="prac_xab_ab_key_resp.status = NOT_STARTED;&amp;#10;prac_xab_ab_key_resp.keys = [];&amp;#10;prac_xab_ab_key_resp.rt = [];&amp;#10;prac_xab_ab_key_resp.clock.reset();&amp;#10;prac_xab_ab_key_resp.clearEvents();&amp;#10;psychoJS.eventManager.clearEvents({&quot;eventType&quot;: &quot;keyboard&quot;});&amp;#10;prac_start_time = core.getTime();&amp;#10;prac_xab_trial += 1;&amp;#10;prac_xab_resp = null;&amp;#10;prac_xab_rt = null;&amp;#10;prac_user_key = null;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# 防止被试在刺激呈现之前按键反应&amp;#10;# 完全重置keyboard组件&amp;#10;prac_xab_ab_key_resp.status = NOT_STARTED&amp;#10;prac_xab_ab_key_resp.keys = []&amp;#10;prac_xab_ab_key_resp.rt = []&amp;#10;prac_xab_ab_key_resp.clock.reset()&amp;#10;prac_xab_ab_key_resp.clearEvents()&amp;#10;event.clearEvents(eventType='keyboard')&amp;#10;&amp;#10;# 记录routine开始时间（用于计算反应时）&amp;#10;prac_start_time = core.getTime()&amp;#10;&amp;#10;# 试次计数+1&amp;#10;prac_xab_trial += 1&amp;#10;&amp;#10;# 初始化反应相关变量&amp;#10;prac_xab_resp = None  # 反应正确性（1=正确，0=错误）&amp;#10;prac_xab_rt = None    # 反应时&amp;#10;prac_user_key = None  # 被试按下的键&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="# 强制控制routine不能自动结束&amp;#10;continueRoutine = True  # 每帧都重新设置为True&amp;#10;&amp;#10;# 按键检测代码&amp;#10;keys = event.getKeys(keyList=['f', 'j'])&amp;#10;if keys and prac_user_key is None:  # 只记录第一次按键&amp;#10;    prac_user_key = keys[0]  # 记录按下的键&amp;#10;    prac_xab_rt = round(core.getTime() - prac_start_time, 3)  # 计算反应时&amp;#10;    &amp;#10;    # 判断反应是否正确&amp;#10;    if prac_user_key == prac_correct_resp:  # 与条件文件中的正确答案比较&amp;#10;        prac_xab_resp = 1  # 正确&amp;#10;    else:&amp;#10;        prac_xab_resp = 0  # 错误&amp;#10;    &amp;#10;    # 只有在按键后才允许routine结束&amp;#10;    continueRoutine = False" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="continueRoutine = true;&amp;#10;keys = psychoJS.eventManager.getKeys({&quot;keyList&quot;: [&quot;f&quot;, &quot;j&quot;]});&amp;#10;if ((keys &amp;&amp; (prac_user_key === null))) {&amp;#10;    prac_user_key = keys[0];&amp;#10;    prac_xab_rt = util.round((core.getTime() - prac_start_time), 3);&amp;#10;    if ((prac_user_key === prac_correct_resp)) {&amp;#10;        prac_xab_resp = 1;&amp;#10;    } else {&amp;#10;        prac_xab_resp = 0;&amp;#10;    }&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="psychoJS.experiment.addData(&quot;prac_xab_block&quot;, prac_xab_block);&amp;#10;psychoJS.experiment.addData(&quot;prac_xab_trial&quot;, prac_xab_trial);&amp;#10;psychoJS.experiment.addData(&quot;prac_xab_resp&quot;, prac_xab_resp);&amp;#10;psychoJS.experiment.addData(&quot;prac_xab_rt&quot;, prac_xab_rt);&amp;#10;psychoJS.experiment.addData(&quot;prac_user_key&quot;, prac_user_key);&amp;#10;psychoJS.experiment.nextEntry();&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# 保存数据到实验文件&amp;#10;thisExp.addData('prac_xab_block', prac_xab_block)&amp;#10;thisExp.addData('prac_xab_trial', prac_xab_trial)&amp;#10;thisExp.addData('prac_xab_resp', prac_xab_resp)&amp;#10;thisExp.addData('prac_xab_rt', prac_xab_rt)&amp;#10;thisExp.addData('prac_user_key', prac_user_key)  # 额外保存被试按的键，便于分析&amp;#10;thisExp.nextEntry()" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="prac_xab_ab_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
