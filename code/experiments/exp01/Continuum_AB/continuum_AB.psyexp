        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="【操作方式】：&amp;#10;&amp;#10;很好！正如您所体验的，对于这种混合情绪，不同的人可能会将鼠标放在中间区域的不同位置，这完全是正常的。&amp;#10;&amp;#10;【请记住】：我们不需要您进行精确计算，只需要您相信自己的直觉。没有标准答案。" valType="str" updates="constant" name="text"/>
