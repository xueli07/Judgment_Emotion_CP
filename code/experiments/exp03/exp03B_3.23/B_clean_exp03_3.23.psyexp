        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# 在 'Begin Experiment' 代码框中&amp;#10;win.mouseVisible = False&amp;#10;&amp;#10;&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="import {event, visual} from 'psychopy';&amp;#10;mouse = new psychoJS.eventManager.Mouse();&amp;#10;rect_left.opacity = 0;&amp;#10;rect_right.opacity = 0;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# 设置Rectangle的初始状态为不可见&amp;#10;prac_cate_resp_rect_left.opacity = 0&amp;#10;prac_cate_resp_rect_right.opacity = 0&amp;#10;&amp;#10;&amp;#10;# 在您的循环之前，设置鼠标的初始位置（在屏幕中心）&amp;#10;prac_cate_resp_mouse.setPos((0, 0))&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# 检测鼠标是否悬停在左边单词上方&amp;#10;if prac_cate_resp_left_calm.contains(prac_cate_resp_mouse):&amp;#10;    prac_cate_resp_rect_left.opacity = 1  # 设置左边Rectangle可见&amp;#10;else:&amp;#10;    prac_cate_resp_rect_left.opacity = 0  # 设置左边Rectangle不可见&amp;#10;&amp;#10;# 检测鼠标是否悬停在右边单词上方&amp;#10;if prac_cate_resp_right_fear.contains(prac_cate_resp_mouse):&amp;#10;    prac_cate_resp_rect_right.opacity = 1  # 设置右边Rectangle可见&amp;#10;else:&amp;#10;    prac_cate_resp_rect_right.opacity = 0  # 设置右边Rectangle不可见&amp;#10;&amp;#10;# 检测鼠标点击事件&amp;#10;if prac_cate_resp_mouse.getPressed()[0]:&amp;#10;    # 检测鼠标点击是否在左边单词上方&amp;#10;    if prac_cate_resp_left_calm.contains(prac_cate_resp_mouse):&amp;#10;        response = '0'  # 记录被试选择左边单词&amp;#10;    # 检测鼠标点击是否在右边单词上方&amp;#10;    elif prac_cate_resp_right_fear.contains(prac_cate_resp_mouse):&amp;#10;        response = '1'  # 记录被试选择右边单词&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;#mouse.setVisible(True)  # 显示鼠标&amp;#10;win.mouseVisible = True" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (text_left.contains(mouse)) {&amp;#10;    rect_left.opacity = 1;&amp;#10;} else {&amp;#10;    rect_left.opacity = 0;&amp;#10;}&amp;#10;if (text_right.contains(mouse)) {&amp;#10;    rect_right.opacity = 1;&amp;#10;} else {&amp;#10;    rect_right.opacity = 0;&amp;#10;}&amp;#10;if (mouse.getPressed()[0]) {&amp;#10;    if (left_calm.contains(mouse)) {&amp;#10;        response = &quot;0&quot;;&amp;#10;    } else {&amp;#10;        if (right_fear.contains(mouse)) {&amp;#10;            response = &quot;1&quot;;&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="win.mouseVisible = False" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="prac_cate_resp_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
