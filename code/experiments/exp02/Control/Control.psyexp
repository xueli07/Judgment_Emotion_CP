        <Param val="form_cate_block += 1;&amp;#10;progress_text = new visual.TextStim({&quot;win&quot;: psychoJS.window, &quot;text&quot;: `已完成${(form_cate_block - 1)}/3部分`, &quot;font&quot;: &quot;Arial&quot;, &quot;pos&quot;: [0, 0.1], &quot;height&quot;: 0.03, &quot;color&quot;: &quot;black&quot;});&amp;#10;text_start_time = core.getTime();&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
