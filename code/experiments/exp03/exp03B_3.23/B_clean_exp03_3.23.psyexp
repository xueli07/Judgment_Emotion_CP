        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="routine" valType="str" updates="constant" name="timeRelativeTo"/>
      </MouseComponent>
      <CodeComponent name="formal_cate_resp_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="import {event, visual} from 'psychopy';&amp;#10;mouse = new psychoJS.eventManager.Mouse();&amp;#10;rect_left.opacity = 0;&amp;#10;rect_right.opacity = 0;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# 设置Rectangle的初始状态为不可见&amp;#10;formal_cate_resp_rect_left.opacity = 0&amp;#10;formal_cate_resp_rect_right.opacity = 0&amp;#10;&amp;#10;prac_cate_resp_mouse.setPos((0, 0))" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# 检测鼠标是否悬停在左边单词上方&amp;#10;if formal_cate_resp_left_calm.contains(formal_cate_resp_mouse):&amp;#10;    formal_cate_resp_rect_left.opacity = 1  # 设置左边Rectangle可见&amp;#10;else:&amp;#10;    formal_cate_resp_rect_left.opacity = 0  # 设置左边Rectangle不可见&amp;#10;&amp;#10;# 检测鼠标是否悬停在右边单词上方&amp;#10;if formal_cate_resp_right_fear.contains(formal_cate_resp_mouse):&amp;#10;    formal_cate_resp_rect_right.opacity = 1  # 设置右边Rectangle可见&amp;#10;else:&amp;#10;    formal_cate_resp_rect_right.opacity = 0  # 设置右边Rectangle不可见&amp;#10;&amp;#10;# 检测鼠标点击事件&amp;#10;if formal_cate_resp_mouse.getPressed()[0]:&amp;#10;    # 检测鼠标点击是否在左边单词上方&amp;#10;    if formal_cate_resp_left_calm.contains(formal_cate_resp_mouse):&amp;#10;        cate_resp = 0  # 记录被试选择左边单词&amp;#10;    # 检测鼠标点击是否在右边单词上方&amp;#10;    elif formal_cate_resp_right_fear.contains(formal_cate_resp_mouse):&amp;#10;        cate_resp = 1  # 记录被试选择右边单词&amp;#10;    else:&amp;#10;        cate_resp = 'None'&amp;#10;else:&amp;#10;    cate_resp = 'None'&amp;#10;    &amp;#10;    &amp;#10;win.mouseVisible = True" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (text_left.contains(mouse)) {&amp;#10;    rect_left.opacity = 1;&amp;#10;} else {&amp;#10;    rect_left.opacity = 0;&amp;#10;}&amp;#10;if (text_right.contains(mouse)) {&amp;#10;    rect_right.opacity = 1;&amp;#10;} else {&amp;#10;    rect_right.opacity = 0;&amp;#10;}&amp;#10;if (mouse.getPressed()[0]) {&amp;#10;    if (left_calm.contains(mouse)) {&amp;#10;        response = &quot;0&quot;;&amp;#10;    } else {&amp;#10;        if (right_fear.contains(mouse)) {&amp;#10;            response = &quot;1&quot;;&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="trialID = trialID + 1&amp;#10;&amp;#10;thisExp.addData('block_name', block_name)&amp;#10;thisExp.addData('trialID', trialID)&amp;#10;thisExp.addData('face_stim', S1cate1cont2)&amp;#10;thisExp.addData('cate_resp', cate_resp)&amp;#10;&amp;#10;win.mouseVisible = False&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="formal_cate_resp_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
