        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="formal_xab_block += 1;&amp;#10;progress_text = new visual.TextStim({&quot;win&quot;: psychoJS.window, &quot;text&quot;: `已完成${(formal_xab_block - 1)}/4部分`, &quot;font&quot;: &quot;Arial&quot;, &quot;pos&quot;: [0, 0.1], &quot;height&quot;: 0.03, &quot;color&quot;: &quot;black&quot;});&amp;#10;text_start_time = core.getTime();&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="##########&amp;#10;# 每次休息，block计数器＋1&amp;#10;formal_xab_block += 1&amp;#10;&amp;#10;#########&amp;#10;# 显示实验进度&amp;#10;progress_text = visual.TextStim(&amp;#10;    win=win,&amp;#10;    text=f'已完成{formal_xab_block - 1}/4部分',  # 直接在这里计算&amp;#10;    font='Arial',&amp;#10;    pos=[0, 0.1],  # 纵坐标0.1&amp;#10;    height=0.03,&amp;#10;    color='black'&amp;#10;)&amp;#10;&amp;#10;# 记录文本开始显示的时间&amp;#10;text_start_time = core.getTime()  " valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="# 控制文本只显示60秒&amp;#10;if core.getTime() - text_start_time &lt;= 60.0:  &amp;#10;    progress_text.draw()" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (((core.getTime() - text_start_time) &lt;= 60.0)) {&amp;#10;    progress_text.draw();&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="xab_break_code" valType="code" updates="None" name="name"/>
