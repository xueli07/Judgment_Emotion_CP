      <CodeComponent name="form_1back_break_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="form_1back_block += 1;&amp;#10;if ((form_1back_block === 2)) {&amp;#10;    rowRange = &quot;88:176&quot;;&amp;#10;} else {&amp;#10;    if ((form_1back_block === 3)) {&amp;#10;        rowRange = &quot;176:264&quot;;&amp;#10;    }&amp;#10;}&amp;#10;progress_text = new visual.TextStim({&quot;win&quot;: psychoJS.window, &quot;text&quot;: `已完成 ${(form_1back_block - 1)}/3 部分`, &quot;font&quot;: &quot;Arial&quot;, &quot;pos&quot;: [0, 0.1], &quot;height&quot;: 0.03, &quot;color&quot;: &quot;black&quot;});&amp;#10;text_start_time = core.getTime();&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# 每次休息，block计数器+1&amp;#10;form_1back_block += 1&amp;#10;&amp;#10;# 根据当前block设置下一个block要读取的行范围&amp;#10;if form_1back_block == 2:&amp;#10;    rowRange = '88:176'  # 第二个block读取第89到176行（索引88-175）&amp;#10;elif form_1back_block == 3:&amp;#10;    rowRange = '176:264'  # 第三个block读取第177到264行（索引176-263）&amp;#10;&amp;#10;# 显示实验进度&amp;#10;progress_text = visual.TextStim(&amp;#10;    win=win,&amp;#10;    text=f'已完成 {form_1back_block-1}/3 部分',font='Arial',&amp;#10;    pos=[0, 0.1],&amp;#10;    height=0.03,&amp;#10;    color='black'&amp;#10;)&amp;#10;&amp;#10;# 记录文本开始显示的时间&amp;#10;text_start_time = core.getTime()" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="# 控制文本只显示60秒&amp;#10;if core.getTime() - text_start_time &lt;= 60.0:  &amp;#10;    progress_text.draw()" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (((core.getTime() - text_start_time) &lt;= 60.0)) {&amp;#10;    progress_text.draw();&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
