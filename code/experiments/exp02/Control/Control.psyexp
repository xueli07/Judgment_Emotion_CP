      <CodeComponent name="prac_1back_face_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="#########&amp;#10;# 以下代码为了保存数据&amp;#10;prac_1back_block = 1  # block计数器（每次重新开始练习时+1）&amp;#10;prac_1back_trial = 0  # trial计数器（每个试次+1）" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="prac_1back_block = 1;&amp;#10;prac_1back_trial = 0;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="prac_1back_face_x_text.color = &quot;black&quot;;&amp;#10;prac_1back_face_m_text.color = &quot;black&quot;;&amp;#10;feedback_given = false;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# 初始化反馈状态&amp;#10;prac_1back_face_x_text.color = 'black'&amp;#10;prac_1back_face_m_text.color = 'black'&amp;#10;feedback_given = False" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="# 检查是否有按键反应且还未给过反馈&amp;#10;if prac_1back_face_key_resp.keys and not feedback_given:&amp;#10;    if prac_1back_face_key_resp.keys[0] == 'x':&amp;#10;        prac_1back_face_x_text.color = 'yellow'&amp;#10;    elif prac_1back_face_key_resp.keys[0] == 'm':&amp;#10;        prac_1back_face_m_text.color = 'yellow'&amp;#10;    feedback_given = True" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if ((prac_1back_face_key_resp.keys &amp;&amp; (! feedback_given))) {&amp;#10;    if ((prac_1back_face_key_resp.keys[0] === &quot;x&quot;)) {&amp;#10;        prac_1back_face_x_text.color = &quot;yellow&quot;;&amp;#10;    } else {&amp;#10;        if ((prac_1back_face_key_resp.keys[0] === &quot;m&quot;)) {&amp;#10;            prac_1back_face_m_text.color = &quot;yellow&quot;;&amp;#10;        }&amp;#10;    }&amp;#10;    feedback_given = true;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="prac_1back_trial += 1;&amp;#10;if (prac_1back_face_key_resp.keys) {&amp;#10;    prac_control_resp = prac_1back_face_key_resp.keys[0];&amp;#10;    prac_control_rt = prac_1back_face_key_resp.rt;&amp;#10;    correct_answer = prac_control_resp_correct;&amp;#10;    if ((correct_answer === &quot;NA&quot;)) {&amp;#10;        prac_control_correct = 1;&amp;#10;    } else {&amp;#10;        if ((prac_control_resp === correct_answer)) {&amp;#10;            prac_control_correct = 1;&amp;#10;        } else {&amp;#10;            prac_control_correct = 0;&amp;#10;        }&amp;#10;    }&amp;#10;} else {&amp;#10;    prac_control_resp = null;&amp;#10;    prac_control_rt = null;&amp;#10;    prac_control_correct = &quot;NA&quot;;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;prac_1back_block&quot;, prac_1back_block);&amp;#10;psychoJS.experiment.addData(&quot;prac_1back_trial&quot;, prac_1back_trial);&amp;#10;psychoJS.experiment.addData(&quot;prac_control_resp&quot;, prac_control_resp);&amp;#10;psychoJS.experiment.addData(&quot;prac_control_correct&quot;, prac_control_correct);&amp;#10;psychoJS.experiment.addData(&quot;prac_control_rt&quot;, prac_control_rt);&amp;#10;console.log(`Trial ${prac_1back_trial}: Response=${prac_control_resp}, Correct=${prac_control_correct}, RT=${prac_control_rt}`);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# 增加试次计数器&amp;#10;prac_1back_trial += 1&amp;#10;&amp;#10;# 提取被试的反应&amp;#10;if prac_1back_face_key_resp.keys:  # 如果被试按了键&amp;#10;    # 获取第一个按键（因为设置的是first key）&amp;#10;    prac_control_resp = prac_1back_face_key_resp.keys[0]&amp;#10;    # 获取反应时&amp;#10;    prac_control_rt = prac_1back_face_key_resp.rt&amp;#10;    &amp;#10;    # 判断反应是否正确&amp;#10;    # 首先获取当前试次的正确答案&amp;#10;    correct_answer = prac_control_resp_correct  # 这个变量来自Excel文件&amp;#10;    &amp;#10;    # 如果正确答案是'NA'（第一个试次），任何反应都算对&amp;#10;    if correct_answer == 'NA':&amp;#10;        prac_control_correct = 1  # 标记为正确&amp;#10;    # 否则比较被试的反应和正确答案&amp;#10;    elif prac_control_resp == correct_answer:&amp;#10;        prac_control_correct = 1  # 正确&amp;#10;    else:&amp;#10;        prac_control_correct = 0  # 错误&amp;#10;        &amp;#10;else:  # 如果被试没有按键（缺失反应）&amp;#10;    prac_control_resp = None&amp;#10;    prac_control_rt = None&amp;#10;    prac_control_correct = 'NA'  &amp;#10;&amp;#10;# 将这些变量添加到thisExp，这样它们会被保存到数据文件中&amp;#10;thisExp.addData('prac_1back_block', prac_1back_block)&amp;#10;thisExp.addData('prac_1back_trial', prac_1back_trial)&amp;#10;thisExp.addData('prac_control_resp', prac_control_resp)&amp;#10;thisExp.addData('prac_control_correct', prac_control_correct)&amp;#10;thisExp.addData('prac_control_rt', prac_control_rt)&amp;#10;&amp;#10;# 可选：打印到控制台，方便调试时查看&amp;#10;print(f&quot;Trial {prac_1back_trial}: Response={prac_control_resp}, Correct={prac_control_correct}, RT={prac_control_rt}&quot;)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="prac_1back_face_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
