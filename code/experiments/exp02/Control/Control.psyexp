        <Param val="True" valType="bool" updates="constant" name="syncScreenRefresh"/>
      </KeyboardComponent>
      <CodeComponent name="form_1back_face_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# 以下代码为了保存数据&amp;#10;form_1back_block = 1  # block计数器&amp;#10;form_1back_trial = 0  # trial计数器&amp;#10;&amp;#10;# 初始化行范围（第一个block读取0-88行，Python索引从0开始）&amp;#10;rowRange = '0:88'" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="form_1back_block = 1;&amp;#10;form_1back_trial = 0;&amp;#10;rowRange = &quot;0:88&quot;;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="form_1back_face_x_text.color = &quot;black&quot;;&amp;#10;form_1back_face_m_text.color = &quot;black&quot;;&amp;#10;feedback_given = false;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# 初始化反馈状态&amp;#10;form_1back_face_x_text.color = 'black'&amp;#10;form_1back_face_m_text.color = 'black'&amp;#10;feedback_given = False" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="# 检查是否有按键反应且还未给过反馈&amp;#10;if form_1back_face_key_resp.keys and not feedback_given:&amp;#10;    if form_1back_face_key_resp.keys[0] == 'x':&amp;#10;        form_1back_face_x_text.color = 'yellow'&amp;#10;    elif form_1back_face_key_resp.keys[0] == 'm':&amp;#10;        form_1back_face_m_text.color = 'yellow'&amp;#10;    feedback_given = True" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if ((form_1back_face_key_resp.keys &amp;&amp; (! feedback_given))) {&amp;#10;    if ((form_1back_face_key_resp.keys[0] === &quot;x&quot;)) {&amp;#10;        form_1back_face_x_text.color = &quot;yellow&quot;;&amp;#10;    } else {&amp;#10;        if ((form_1back_face_key_resp.keys[0] === &quot;m&quot;)) {&amp;#10;            form_1back_face_m_text.color = &quot;yellow&quot;;&amp;#10;        }&amp;#10;    }&amp;#10;    feedback_given = true;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="form_1back_trial += 1;&amp;#10;if (form_1back_face_key_resp.keys) {&amp;#10;    form_control_resp = form_1back_face_key_resp.keys[0];&amp;#10;    form_control_rt = form_1back_face_key_resp.rt;&amp;#10;    correct_answer = formal_control_resp_correct;&amp;#10;    if ((correct_answer === &quot;NA&quot;)) {&amp;#10;        form_control_correct = 1;&amp;#10;    } else {&amp;#10;        if ((form_control_resp === correct_answer)) {&amp;#10;            form_control_correct = 1;&amp;#10;        } else {&amp;#10;            form_control_correct = 0;&amp;#10;        }&amp;#10;    }&amp;#10;} else {&amp;#10;    form_control_resp = null;&amp;#10;    form_control_rt = null;&amp;#10;    form_control_correct = &quot;NA&quot;;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;form_1back_block&quot;, form_1back_block);&amp;#10;psychoJS.experiment.addData(&quot;form_1back_trial&quot;, form_1back_trial);&amp;#10;psychoJS.experiment.addData(&quot;form_control_resp&quot;, form_control_resp);&amp;#10;psychoJS.experiment.addData(&quot;form_control_correct&quot;, form_control_correct);&amp;#10;psychoJS.experiment.addData(&quot;form_control_rt&quot;, form_control_rt);&amp;#10;console.log(`Trial ${form_1back_trial}: Response=${form_control_resp}, Correct=${form_control_correct}, RT=${form_control_rt}`);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# 增加试次计数器&amp;#10;form_1back_trial += 1&amp;#10;# 提取被试的反应&amp;#10;if form_1back_face_key_resp.keys:  # 如果被试按了键&amp;#10;    # 获取第一个按键（因为设置的是first key）&amp;#10;    form_control_resp = form_1back_face_key_resp.keys[0]&amp;#10;    # 获取反应时&amp;#10;    form_control_rt = form_1back_face_key_resp.rt&amp;#10;&amp;#10;    # 判断反应是否正确&amp;#10;    # 首先获取当前试次的正确答案&amp;#10;    correct_answer = formal_control_resp_correct  # 这个变量来自Excel文件&amp;#10;&amp;#10;    # 如果正确答案是'NA'（第一个试次），任何反应都算对&amp;#10;    if correct_answer == 'NA':&amp;#10;        form_control_correct = 1  # 标记为正确&amp;#10;    # 否则比较被试的反应和正确答案&amp;#10;    elif form_control_resp == correct_answer:&amp;#10;        form_control_correct = 1  # 正确&amp;#10;    else:&amp;#10;        form_control_correct = 0  # 错误&amp;#10;&amp;#10;else:  # 如果被试没有按键（缺失反应）&amp;#10;    form_control_resp = None&amp;#10;    form_control_rt = None&amp;#10;    form_control_correct = 'NA'&amp;#10;&amp;#10;# 将这些变量添加到thisExp，这样它们会被保存到数据文件中&amp;#10;thisExp.addData('form_1back_block', form_1back_block)&amp;#10;thisExp.addData('form_1back_trial', form_1back_trial)&amp;#10;thisExp.addData('form_control_resp', form_control_resp)&amp;#10;thisExp.addData('form_control_correct', form_control_correct)&amp;#10;thisExp.addData('form_control_rt', form_control_rt)&amp;#10;&amp;#10;# 可选：打印到控制台，方便调试时查看&amp;#10;print(f&quot;Trial {form_1back_trial}: Response={form_control_resp}, Correct={form_control_correct}, RT={form_control_rt}&quot;)&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="form_1back_face_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
