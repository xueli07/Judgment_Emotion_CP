      <Param name="name" updates="None" val="formal_cate" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="formal_cate_begin"/>
    <Routine name="formal_cate_fix"/>
    <Routine name="formal_cate_face"/>
    <Routine name="formal_cate_resp"/>
    <LoopTerminator name="formal_cate"/>
    <Routine name="end_exp"/>
  </Flow>
</PsychoPy2experiment>
