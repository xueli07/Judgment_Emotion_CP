      </MouseComponent>
      <CodeComponent name="form_resp_f_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="psychoJS.window.mouseVisible = true;&amp;#10;form_resp_f_mouse.setPos([0, (- 0.25)]);&amp;#10;form_resp_f_slider.marker.size = [0.02, 0.08];&amp;#10;form_resp_f_slider.marker.shape = &quot;square&quot;;&amp;#10;form_resp_f_slider.marker.fillColor = &quot;white&quot;;&amp;#10;slider_width = 0.8;&amp;#10;form_cont_trial += 1;&amp;#10;form_current_gender = &quot;female&quot;;&amp;#10;start_time = core.getTime();&amp;#10;form_cont_resp = null;&amp;#10;form_cont_rt = null;&amp;#10;form_previous_gender = form_current_gender;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="##########&amp;#10;# 以下是组件基本设置的代码：&amp;#10;&amp;#10;# 鼠标设置&amp;#10;win.mouseVisible = True&amp;#10;# 初始化鼠标位置在slider中间&amp;#10;form_resp_f_mouse.setPos([0, -0.25])&amp;#10;&amp;#10;# 设置slider的marker外观&amp;#10;form_resp_f_slider.marker.size = (0.02, 0.08)&amp;#10;form_resp_f_slider.marker.shape = 'square'&amp;#10;form_resp_f_slider.marker.fillColor = 'white'&amp;#10;# 记录slider宽度，用于后续计算&amp;#10;slider_width = 0.8&amp;#10;&amp;#10;############&amp;#10;# 以下代码用于保存和记录数据&amp;#10;&amp;#10;# 试次计数和性别标记&amp;#10;form_cont_trial += 1&amp;#10;form_current_gender = 'female'&amp;#10;&amp;#10;# 记录这个试次开始的时间，用于后续计算反应时&amp;#10;start_time = core.getTime()&amp;#10;form_cont_resp = None  # 初始化反应值&amp;#10;form_cont_rt = None    # 初始化反应时间&amp;#10;&amp;#10;# 更新previous_gender变量，&amp;#10;# 为下一个试次的mini-block检测做准备&amp;#10;form_previous_gender = form_current_gender&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="##########&amp;#10;# 获取当前鼠标位置&amp;#10;mouse_pos = form_resp_f_mouse.getPos()&amp;#10;mouse_x, mouse_y = mouse_pos&amp;#10;&amp;#10;# 基于slider的位置和大小，计算slider的边界&amp;#10;slider_center_x = 0&amp;#10;slider_center_y = -0.25&amp;#10;slider_left = slider_center_x - slider_width/2&amp;#10;slider_right = slider_center_x + slider_width/2&amp;#10;slider_bottom = slider_center_y - 0.025&amp;#10;slider_top = slider_center_y + 0.025&amp;#10;&amp;#10;# 检查鼠标是否在slider区域内&amp;#10;mouse_in_slider = (slider_left &lt;= mouse_x &lt;= slider_right and&amp;#10;                   slider_bottom &lt;= mouse_y &lt;= slider_top)&amp;#10;&amp;#10;# 处理slider交互逻辑&amp;#10;if mouse_in_slider:&amp;#10;    # 计算slider值，修正边界问题&amp;#10;    slider_value = (mouse_x - slider_left) / slider_width&amp;#10;&amp;#10;    # 关键修改：扩大边界范围，允许0和1&amp;#10;    if slider_value &lt; 0.01:&amp;#10;        slider_value = 0.0&amp;#10;    elif slider_value &gt; 0.99:&amp;#10;        slider_value = 1.0&amp;#10;    else:&amp;#10;        slider_value = max(0, min(1, slider_value))&amp;#10;&amp;#10;    # 更新slider marker位置&amp;#10;    form_resp_f_slider.markerPos = slider_value&amp;#10;&amp;#10;    # 检测鼠标点击&amp;#10;    if form_resp_f_mouse.getPressed()[0]:&amp;#10;        # 保存反应数据&amp;#10;        form_cont_resp = round(slider_value, 2)&amp;#10;        form_cont_rt = round(core.getTime() - start_time, 3)&amp;#10;        continueRoutine = False" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="mouse_pos = form_resp_f_mouse.getPos();&amp;#10;[mouse_x, mouse_y] = mouse_pos;&amp;#10;slider_center_x = 0;&amp;#10;slider_center_y = (- 0.25);&amp;#10;slider_left = (slider_center_x - (slider_width / 2));&amp;#10;slider_right = (slider_center_x + (slider_width / 2));&amp;#10;slider_bottom = (slider_center_y - 0.025);&amp;#10;slider_top = (slider_center_y + 0.025);&amp;#10;mouse_in_slider = (((slider_left &lt;= mouse_x) &amp;&amp; (mouse_x &lt;= slider_right)) &amp;&amp; ((slider_bottom &lt;= mouse_y) &amp;&amp; (mouse_y &lt;= slider_top)));&amp;#10;if (mouse_in_slider) {&amp;#10;    slider_value = ((mouse_x - slider_left) / slider_width);&amp;#10;    if ((slider_value &lt; 0.01)) {&amp;#10;        slider_value = 0.0;&amp;#10;    } else {&amp;#10;        if ((slider_value &gt; 0.99)) {&amp;#10;            slider_value = 1.0;&amp;#10;        } else {&amp;#10;            slider_value = Math.max(0, Math.min(1, slider_value));&amp;#10;        }&amp;#10;    }&amp;#10;    form_resp_f_slider.markerPos = slider_value;&amp;#10;    if (form_resp_f_mouse.getPressed()[0]) {&amp;#10;        form_cont_resp = util.round(slider_value, 2);&amp;#10;        form_cont_rt = util.round((core.getTime() - start_time), 3);&amp;#10;        continueRoutine = false;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="psychoJS.experiment.addData(&quot;form_cont_block&quot;, form_cont_block);&amp;#10;psychoJS.experiment.addData(&quot;form_cont_trial&quot;, form_cont_trial);&amp;#10;psychoJS.experiment.addData(&quot;form_current_gender&quot;, form_current_gender);&amp;#10;psychoJS.experiment.addData(&quot;form_cont_resp&quot;, form_cont_resp);&amp;#10;psychoJS.experiment.addData(&quot;form_cont_rt&quot;, form_cont_rt);&amp;#10;psychoJS.experiment.nextEntry();&amp;#10;psychoJS.window.mouseVisible = false;&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="#########&amp;#10;# 以下代码是为了保存数据&amp;#10;&amp;#10;# block数&amp;#10;thisExp.addData('form_cont_block', form_cont_block)&amp;#10;# trial数&amp;#10;thisExp.addData('form_cont_trial', form_cont_trial)&amp;#10;# 当前模特性别&amp;#10;thisExp.addData('form_current_gender', form_current_gender)&amp;#10;# 被试连续评分值&amp;#10;thisExp.addData('form_cont_resp', form_cont_resp)&amp;#10;# 反应时间&amp;#10;thisExp.addData('form_cont_rt', form_cont_rt)&amp;#10;# 进入下一条数据记录&amp;#10;thisExp.nextEntry()&amp;#10;&amp;#10;# 隐藏鼠标&amp;#10;win.mouseVisible = False&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="form_resp_f_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
