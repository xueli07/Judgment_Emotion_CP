      <CodeComponent name="formal_continuous_rating_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="trialID = 0&amp;#10;blockID = 1" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="trialID = 0;&amp;#10;blockID = 1;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="formal_continuous_rating_slider_width = 0.5;&amp;#10;formal_continuous_rating_slider_height = 0.05;&amp;#10;formal_continuous_rating_slider_orientation = 0;&amp;#10;formal_continuous_rating_slider_ticks = [0, 1];&amp;#10;formal_continuous_rating_slider_granularity = 0.1;&amp;#10;formal_continuous_rating_slider_decimals = 2;&amp;#10;formal_continuous_rating_slider.decimals = formal_continuous_rating_slider_decimals;&amp;#10;marker = formal_continuous_rating_slider.marker;&amp;#10;marker.shape = &quot;square&quot;;&amp;#10;marker.size = [0.01, 0.05];&amp;#10;start_time = core.getTime();&amp;#10;formal_continuous_rating_rt = null;&amp;#10;formal_continuous_rating = null;&amp;#10;console.log(&quot;formal_continuous_rating \u7684\u7c7b\u578b\u662f:&quot;, Object.getPrototypeOf(formal_continuous_rating));&amp;#10;console.log(trialID);&amp;#10;mouseRec = formal_continuous_rating_mouse.getPos();&amp;#10;formal_continuous_rating_mouse.setPos([0, 0]);&amp;#10;has_moved = false;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# --- 初始化评分参数 ---&amp;#10;formal_continuous_rating_slider_width = 0.5       # 滑块宽度（相对单位）&amp;#10;formal_continuous_rating_slider_height = 0.05      # 滑块高度&amp;#10;formal_continuous_rating_slider_orientation = 0    # 滑块方向（0：水平）&amp;#10;formal_continuous_rating_slider_ticks = [0, 1]       # 滑块刻度&amp;#10;formal_continuous_rating_slider_granularity = 0.1    # 滑块精度&amp;#10;formal_continuous_rating_slider_decimals = 2         # 显示小数位数&amp;#10;&amp;#10;# --- 设置滑块样式 ---&amp;#10;formal_continuous_rating_slider.decimals = formal_continuous_rating_slider_decimals&amp;#10;marker = formal_continuous_rating_slider.marker&amp;#10;marker.shape = 'square'                   # 标记形状为方形&amp;#10;marker.size = (0.01, 0.05)                # 标记大小&amp;#10;&amp;#10;# --- 初始化变量 ---&amp;#10;start_time = core.getTime() # 当前例程起始时间&amp;#10;formal_continuous_rating_rt = None                        # 记录响应时间&amp;#10;formal_continuous_rating = None # 连续响应值&amp;#10;&amp;#10;print(&quot;formal_continuous_rating 的类型是:&quot;, type(formal_continuous_rating))&amp;#10;&amp;#10;print(trialID)&amp;#10;&amp;#10;mouseRec = formal_continuous_rating_mouse.getPos() &amp;#10;formal_continuous_rating_mouse.setPos((0, 0))&amp;#10;has_moved = False" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="&amp;#10;# 实时更新 marker 位置&amp;#10;mouse_Rec = formal_continuous_rating_mouse.getPos()&amp;#10;if formal_continuous_rating_marker.contains(formal_continuous_rating_mouse):&amp;#10;   if mouse_Rec[0] != 0:&amp;#10;        has_moved = True&amp;#10;   formal_continuous_rating_slider.markerPos = mouse_Rec[formal_continuous_rating_slider_orientation] / formal_continuous_rating_slider_width * (formal_continuous_rating_slider_ticks[-1]-formal_continuous_rating_slider_ticks[0]) + (formal_continuous_rating_slider_ticks[0]+formal_continuous_rating_slider_ticks[-1]) / 2&amp;#10;   if formal_continuous_rating_mouse.getPressed()[0]:&amp;#10;       formal_continuous_rating = round(formal_continuous_rating_slider.markerPos, formal_continuous_rating_slider_decimals)           &amp;#10;       if formal_continuous_rating_rt is None:  # 仅记录第一次点击的反应时&amp;#10;            formal_continuous_rating_rt = core.getTime() - start_time&amp;#10;   else:&amp;#10;       formal_continuous_rating = None&amp;#10;elif mouse_Rec[0] &gt; 0.25:&amp;#10;    formal_continuous_rating_mouse.setPos((0.25, 0))&amp;#10;elif mouse_Rec[0] &lt; -0.25:&amp;#10;    formal_continuous_rating_mouse.setPos((-0.25, 0))&amp;#10;win.mouseVisible = False&amp;#10;&amp;#10;if gotValidClick and has_moved:&amp;#10;    continueRoutine = False&amp;#10;else:&amp;#10;    gotValidClick = False" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="mouse_Rec = formal_continuous_rating_mouse.getPos();&amp;#10;if (formal_continuous_rating_marker.contains(formal_continuous_rating_mouse)) {&amp;#10;    if ((mouse_Rec[0] !== 0)) {&amp;#10;        has_moved = true;&amp;#10;    }&amp;#10;    formal_continuous_rating_slider.markerPos = (((mouse_Rec[formal_continuous_rating_slider_orientation] / formal_continuous_rating_slider_width) * (formal_continuous_rating_slider_ticks.slice((- 1))[0] - formal_continuous_rating_slider_ticks[0])) + ((formal_continuous_rating_slider_ticks[0] + formal_continuous_rating_slider_ticks.slice((- 1))[0]) / 2));&amp;#10;    if (formal_continuous_rating_mouse.getPressed()[0]) {&amp;#10;        formal_continuous_rating = util.round(formal_continuous_rating_slider.markerPos, formal_continuous_rating_slider_decimals);&amp;#10;        if ((formal_continuous_rating_rt === null)) {&amp;#10;            formal_continuous_rating_rt = (core.getTime() - start_time);&amp;#10;        }&amp;#10;    } else {&amp;#10;        formal_continuous_rating = null;&amp;#10;    }&amp;#10;} else {&amp;#10;    if ((mouse_Rec[0] &gt; 0.25)) {&amp;#10;        formal_continuous_rating_mouse.setPos([0.25, 0]);&amp;#10;    } else {&amp;#10;        if ((mouse_Rec[0] &lt; (- 0.25))) {&amp;#10;            formal_continuous_rating_mouse.setPos([(- 0.25), 0]);&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;psychoJS.window.mouseVisible = false;&amp;#10;if ((gotValidClick &amp;&amp; has_moved)) {&amp;#10;    continueRoutine = false;&amp;#10;} else {&amp;#10;    gotValidClick = false;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="trialID = (trialID + 1);&amp;#10;if (formal_continuous_rating_mouse.x) {&amp;#10;    last_x = formal_continuous_rating_mouse.x.slice((- 1))[0];&amp;#10;    if ((last_x &gt; 0)) {&amp;#10;        side_chosen = 1;&amp;#10;    } else {&amp;#10;        if ((last_x &lt; 0)) {&amp;#10;            side_chosen = 0;&amp;#10;        } else {&amp;#10;            side_chosen = (- 1);&amp;#10;        }&amp;#10;    }&amp;#10;} else {&amp;#10;    side_chosen = null;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;formal_continuous_rating_rt&quot;, formal_continuous_rating_rt);&amp;#10;psychoJS.experiment.addData(&quot;formal_continuous_rating&quot;, formal_continuous_rating);&amp;#10;psychoJS.experiment.addData(&quot;trialID&quot;, trialID);&amp;#10;psychoJS.experiment.addData(&quot;blockID&quot;, blockID);&amp;#10;psychoJS.experiment.addData(&quot;Raw_chosen&quot;, last_x);&amp;#10;psychoJS.experiment.addData(&quot;side_chosen&quot;, side_chosen);&amp;#10;psychoJS.window.mouseVisible = false;&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="#更新试次&amp;#10;trialID = trialID + 1&amp;#10;# 创建新变量side_chosen&amp;#10;if formal_continuous_rating_mouse.x:  # 检查是否有鼠标数据&amp;#10;    # 取最后一次记录的x坐标&amp;#10;    last_x = formal_continuous_rating_mouse.x[-1]&amp;#10;    &amp;#10;    # 判断x值并赋值&amp;#10;    if last_x &gt; 0:&amp;#10;        side_chosen = 1&amp;#10;    elif last_x &lt; 0:&amp;#10;        side_chosen = 0&amp;#10;    else:&amp;#10;        side_chosen = -1  # 处理x=0的情况&amp;#10;else:&amp;#10;    side_chosen = None  # 无数据时设为空&amp;#10;&amp;#10;#保存数据&amp;#10;thisExp.addData('formal_continuous_rating_rt', formal_continuous_rating_rt)&amp;#10;thisExp.addData('formal_continuous_rating', formal_continuous_rating)&amp;#10;thisExp.addData('trialID', trialID)&amp;#10;thisExp.addData('blockID', blockID)&amp;#10;thisExp.addData('Raw_chosen',last_x)#记录原始选择&amp;#10;thisExp.addData('side_chosen', side_chosen)  # 新增的数据列&amp;#10;win.mouseVisible = False&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="formal_continuous_rating_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
