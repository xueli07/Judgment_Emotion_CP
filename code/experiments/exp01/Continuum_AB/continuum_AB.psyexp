        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="【重要说明】:&amp;#10;&amp;#10;1.在实验中，你将会看到两个人的面孔。&amp;#10;&amp;#10;实验分为几个短小的部分，每个部分会专注于其中一人的情绪面孔&amp;#10;&amp;#10;2.每一部分中，会出现多张同一人的面孔，&amp;#10;&amp;#10;但每张面孔之间可能会有微妙的情绪差异，&amp;#10;&amp;#10;请您仔细感受并根据直觉印象进行评分，没有标准答案。&amp;#10;&amp;#10;3.在每个部分之间会有短暂的休息时间，&amp;#10;&amp;#10;你可以眨眨眼或者稍微放松一下，整个实验会自动引导你完成，&amp;#10;&amp;#10;你只需要专注于对每张面孔的情绪进行判断即可。&amp;#10;&amp;#10;接下来，我们将在练习中进一步熟悉这个任务。&amp;#10;" valType="str" updates="set every repeat" name="text"/>
