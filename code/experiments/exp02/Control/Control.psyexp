      <KeyboardComponent name="prac_end_key_resp" plugin="None">
        <Param val="'space','p'" valType="list" updates="constant" name="allowedKeys"/>
        <Param val="" valType="str" updates="constant" name="correctAns"/>
        <Param val="" valType="str" updates="None" name="deviceLabel"/>
